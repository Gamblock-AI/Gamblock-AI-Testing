# Local evidence staging; only promoted allowlisted records are public.
*/private/
/tmp/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.webm
*.log
*.trace
*.pcap

# Generated/intermediate evaluation output.
__pycache__/
*.pyc
/docs/tools/.generated/
*/.generated/
*.json.tmp
*.pdf

# Model aggregate charts are public-safe generated evidence. All other images
# remain blocked by the raw-artifact rule above.
!model/evidence/
!model/evidence/visuals/
!model/evidence/visuals/historical_confusion_matrix.png
!model/evidence/visuals/domain_grouped_confusion_matrix.png
!model/evidence/visuals/domain_grouped_ablation_metrics.png
!model/evidence/visuals/domain_grouped_threshold_sensitivity.png
!model/evidence/visuals/domain_grouped_calibration.png

# Credentials and local configuration.
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
